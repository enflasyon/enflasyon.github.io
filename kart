import sys
import re
import queue
from datetime import datetime, timedelta
from PySide6.QtCore import QThread, Signal, QDate, QTimer
from PySide6.QtWidgets import (QApplication, QWidget, QLabel, QLineEdit,
    QDateEdit, QPushButton, QVBoxLayout, QHBoxLayout, QFrame)

URL = ('https://report.tei.com.tr/Reports/report/'
       'İnsan%20Kaynakları/PDKS/8.Günlük%20Giriş-Çıkış%20Raporu')
DURATION = timedelta(hours=9, minutes=30)
JS = '''return Array.from(document.querySelectorAll('tr'))
.filter(r => r.getClientRects().length > 0)
.map(r => Array.from(r.children)
.filter(c => ['TD','TH'].includes(c.tagName)).map(c => c.innerText.trim()));'''


def parse_rows(rows, badge, date):
    records = set()
    for cells in rows:
        if len(cells) != 5:
            continue
        number, name, day, time, _ = cells
        if number.strip() != badge or day.strip() != date:
            continue
        if re.fullmatch(r'\d{2}:\d{2}(?::\d{2})?', time):
            fmt = '%d.%m.%Y %H:%M:%S' if time.count(':') == 2 else '%d.%m.%Y %H:%M'
            start = datetime.strptime(f'{day} {time}', fmt)
            records.add((name, start))
    return records


def scan(driver, badge, date):
    from selenium.webdriver.common.by import By
    records = parse_rows(driver.execute_script(JS), badge, date)
    for frame in driver.find_elements(By.CSS_SELECTOR, 'iframe, frame'):
        driver.switch_to.frame(frame)
        try:
            records.update(scan(driver, badge, date))
        finally:
            driver.switch_to.parent_frame()
    return records


class BrowserWorker(QThread):
    done = Signal(str, object)

    def __init__(self):
        super().__init__()
        self.jobs = queue.Queue()

    def run(self):
        from selenium import webdriver
        from selenium.webdriver.support.ui import WebDriverWait
        from selenium.common.exceptions import TimeoutException, StaleElementReferenceException
        driver = None
        try:
            while True:
                action, data = self.jobs.get()
                if action == 'quit':
                    break
                try:
                    if action == 'open':
                        if driver:
                            try:
                                driver.quit()
                            except Exception:
                                pass
                            driver = None
                        driver = webdriver.Chrome()
                        driver.set_page_load_timeout(45)
                        driver.get(data)
                        self.done.emit('ready', None)
                    elif action == 'read':
                        if driver is None:
                            raise ValueError('Önce raporu açın.')
                        badge, date = data
                        def poll(d):
                            d.switch_to.default_content()
                            return scan(d, badge, date) or False
                        records = WebDriverWait(driver, 20,
                            ignored_exceptions=(StaleElementReferenceException,)).until(poll)
                        if len(records) != 1:
                            raise ValueError('Birden fazla giriş bulundu. Raporu tek giriş kaydına filtreleyin.')
                        self.done.emit('result', next(iter(records)))
                except TimeoutException:
                    self.done.emit('error', 'Süre doldu. Raporu, tarih filtresini ve yaka numarasını kontrol edin.')
                except Exception as exc:
                    self.done.emit('error', str(exc).split('\n')[0][:240])
        finally:
            if driver:
                try:
                    driver.quit()
                except Exception:
                    pass


