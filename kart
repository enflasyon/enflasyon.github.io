import re
from datetime import datetime, timedelta

from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.common.exceptions import TimeoutException

URL = (
    "https://report.tei.com.tr/Reports/report/"
    "İnsan%20Kaynakları/PDKS/8.Günlük%20Giriş-Çıkış%20Raporu"
)

MESAİ = timedelta(hours=9, minutes=30)

# Görseldeki sütun sırası:
# Yaka No | Adı Soyadı | Tarih | Giriş Zamanı | Çıkış Zamanı
SATIRLARI_OKU = """
return Array.from(document.querySelectorAll("tr"))
    .filter(row => row.getClientRects().length > 0)
    .map(row => Array.from(row.children)
        .filter(cell => ["TD", "TH"].includes(cell.tagName))
        .map(cell => cell.innerText.trim()));
"""


def kayitlari_bul(driver, yaka_no, tarih):
    bulunanlar = []

    for hucreler in driver.execute_script(SATIRLARI_OKU):
        if len(hucreler) != 5:
            continue

        yaka, ad, gun, giris, _ = hucreler

        if yaka != yaka_no or gun != tarih:
            continue

        if re.fullmatch(r"\d{2}:\d{2}(?::\d{2})?", giris):
            bulunanlar.append((ad, gun, giris))

    # Rapor iframe içinde açılmışsa onun içini de oku.
    for frame in driver.find_elements(By.CSS_SELECTOR, "iframe, frame"):
        driver.switch_to.frame(frame)
        try:
            bulunanlar.extend(kayitlari_bul(driver, yaka_no, tarih))
        finally:
            driver.switch_to.parent_frame()

    return bulunanlar


def main():
    yaka_no = input("Yaka numaranız: ").strip()
    tarih = input("Rapor tarihi (GG.AA.YYYY, bugün için Enter): ").strip()
    tarih = tarih or datetime.now().strftime("%d.%m.%Y")
    datetime.strptime(tarih, "%d.%m.%Y")

    driver = webdriver.Chrome()

    try:
        driver.get(URL)

        print(
            f"\nAçılan tarayıcıda gerekiyorsa oturum açın.\n"
            f"Başlangıç ve bitiş tarihini {tarih} yapıp raporu görüntüleyin."
        )
        input("Rapor tablosu yüklendiğinde burada Enter'a basın...")

        def raporu_oku(d):
            d.switch_to.default_content()
            return kayitlari_bul(d, yaka_no, tarih) or False

        kayitlar = WebDriverWait(driver, 30).until(raporu_oku)
        kayitlar = list(set(kayitlar))

        if len(kayitlar) != 1:
            raise ValueError(
                "Birden fazla giriş kaydı bulundu. "
                "Raporu tek kişi ve tek giriş kaydı olacak şekilde filtreleyin."
            )

        ad, gun, saat = kayitlar[0]
        bicim = "%d.%m.%Y %H:%M:%S" if saat.count(":") == 2 else "%d.%m.%Y %H:%M"
        giris = datetime.strptime(f"{gun} {saat}", bicim)
        cikis = giris + MESAİ

        print(f"\nAdı soyadı : {ad}")
        print(f"Giriş      : {giris:%d.%m.%Y %H:%M}")
        print(f"Çıkış      : {cikis:%d.%m.%Y %H:%M}")

    except TimeoutException:
        print(
            "\nKayıt bulunamadı. Yaka numarasını, rapor tarihini "
            "ve giriş saatinin dolu olduğunu kontrol edin."
        )
    finally:
        driver.quit()


if __name__ == "__main__":
    main()