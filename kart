class Window(QWidget):
    def __init__(self, demo=False):
        super().__init__()
        self.worker = None
        self.closing = False
        self.end = None
        self.demo = demo
        self.setWindowTitle('Çıkış Saati • Mesai Hesaplayıcı')
        self.resize(730, 750)
        self.setMinimumWidth(680)
        self.setStyleSheet(STYLE)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(32, 26, 32, 26)
        layout.setSpacing(16)
        def label(text, style='muted'):
            w = QLabel(text)
            w.setObjectName(style)
            w.setWordWrap(True)
            return w
        layout.addWidget(label('MESAİ HESAPLAYICI  /  09 SA 30 DK', 'eyebrow'))
        layout.addWidget(label('Çıkış saatim kaç?', 'title'))
        layout.addWidget(label('Giriş saatin rapordan okunsun, çıkış saatin hesaplansın.'))
        self.url = QLineEdit(URL)
        layout.addWidget(label('Rapor adresi'))
        layout.addWidget(self.url)
        form = QHBoxLayout()
        for title, widget in [('Yaka numarası', QLineEdit()), ('Rapor tarihi', QDateEdit())]:
            column = QVBoxLayout()
            column.addWidget(label(title))
            column.addWidget(widget)
            form.addLayout(column)
            if isinstance(widget, QLineEdit):
                self.badge = widget
                widget.setPlaceholderText('Yaka numaranızı yazın')
            else:
                self.date = widget
                widget.setDisplayFormat('dd.MM.yyyy')
                widget.setCalendarPopup(True)
                widget.setDate(QDate.currentDate())
        layout.addLayout(form)
        buttons = QHBoxLayout()
        self.open_button = QPushButton('1  Raporu aç')
        self.read_button = QPushButton('2  Girişi oku ve hesapla')
        self.read_button.setObjectName('primary')
        self.read_button.setEnabled(False)
        buttons.addWidget(self.open_button)
        buttons.addWidget(self.read_button)
        layout.addLayout(buttons)
        self.open_button.clicked.connect(self.open_report)
        self.read_button.clicked.connect(self.read_report)
        layout.addWidget(label('Chrome’da oturum açın, seçtiğiniz tarihin raporunu görüntüleyin.\nArdından “Girişi oku ve hesapla” düğmesine basın.'))
        card = QFrame()
        card.setObjectName('card')
        cards = QHBoxLayout(card)
        cards.setContentsMargins(24, 20, 24, 20)
        for title, attr, style in [('GİRİŞ SAATİ', 'start_label', 'time'), ('HESAPLANAN ÇIKIŞ', 'end_label', 'exit')]:
            col = QVBoxLayout()
            col.addWidget(label(title))
            value = label('--:--', style)
            setattr(self, attr, value)
            col.addWidget(value)
            cards.addLayout(col)
        layout.addWidget(card)
        self.person = label('Henüz giriş kaydı okunmadı.')
        self.remaining = label('Giriş + 9 saat 30 dakika', 'eyebrow')
        self.status = label('Hazır • Raporu açarak başlayın.')
        layout.addWidget(self.person)
        layout.addWidget(self.remaining)
        layout.addStretch()
        layout.addWidget(self.status)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(1000)
        self.badge.textChanged.connect(self.clear_result)
        self.date.dateChanged.connect(self.clear_result)
        if demo:
            self.badge.setText('3365')
            self.date.setDate(QDate(2026, 10, 7))
            self.show_result(('Örnek kayıt', datetime(2026, 10, 7, 10, 28)))
            self.remaining.setText('Giriş + 9 saat 30 dakika = 19:58')
            self.status.setText('ÖNİZLEME • Görseldeki saatle örnek hesaplama; canlı veri değildir.')
            self.open_button.setEnabled(False)

    def clear_result(self, *_):
        self.end = None
        self.start_label.setText('--:--')
        self.end_label.setText('--:--')
        self.person.setText('Henüz giriş kaydı okunmadı.')
        self.remaining.setText('Giriş + 9 saat 30 dakika')

    def busy(self, value):
        for widget in [self.open_button, self.read_button, self.badge, self.date, self.url]:
            widget.setEnabled(not value)

    def open_report(self):
        self.clear_result()
        if self.worker is None:
            try:
                import selenium
            except ImportError:
                self.status.setText('Kurulum gerekli: python -m pip install selenium')
                return
            self.worker = BrowserWorker()
            self.worker.done.connect(self.receive)
            self.worker.finished.connect(self.worker_finished)
            self.worker.start()
        self.busy(True)
        self.status.setText('Chrome açılıyor…')
        self.worker.jobs.put(('open', self.url.text().strip()))

    def read_report(self):
        if not self.badge.text().strip():
            self.status.setText('Lütfen yaka numaranızı yazın.')
            return
        self.clear_result()
        self.busy(True)
        self.status.setText('Giriş kaydı aranıyor…')
        self.worker.jobs.put(('read', (self.badge.text().strip(), self.date.date().toString('dd.MM.yyyy'))))

    def receive(self, kind, data):
        if self.closing:
            return
        self.busy(False)
        if kind == 'ready':
            self.status.setText('Rapor açıldı • Tarih filtresini ayarlayıp girişi okuyun.')
        elif kind == 'result':
            self.show_result(data)
            self.status.setText('Hesaplandı • Süre, giriş saatine doğrudan eklendi.')
        else:
            self.status.setText('İşlem tamamlanamadı: ' + data)

    def show_result(self, record):
        name, start = record
        self.end = start + DURATION
        self.start_label.setText(start.strftime('%H:%M:%S'))
        self.end_label.setText(self.end.strftime('%H:%M:%S'))
        self.person.setText(f'{name}  •  Giriş: {start:%d.%m.%Y}  •  Çıkış: {self.end:%d.%m.%Y}')
        self.tick()

    def tick(self):
        if self.end is None or self.demo:
            return
        seconds = int((self.end - datetime.now()).total_seconds())
        if seconds <= 0:
            self.remaining.setText('Hesaplanan çıkış zamanı geldi.')
        else:
            h, rem = divmod(seconds, 3600)
            m, s = divmod(rem, 60)
            self.remaining.setText(f'Çıkışa kalan  •  {h:02}:{m:02}:{s:02}')

    def worker_finished(self):
        if self.closing:
            self.close()

    def closeEvent(self, event):
        if self.worker and self.worker.isRunning():
            event.ignore()
            if not self.closing:
                self.closing = True
                self.busy(True)
                self.status.setText('Tarayıcı kapatılıyor; devam eden işlem bekleniyor…')
                self.worker.jobs.put(('quit', None))
        else:
            event.accept()


if __name__ == '__main__':
    app = QApplication(sys.argv)
    window = Window(demo='--demo' in sys.argv)
    window.show()
    sys.exit(app.exec())
