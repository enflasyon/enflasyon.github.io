    def bt0_command(self):  # Import and Convert File
        rpc_file_path = askopenfilename()  # RPC File Path
        if not rpc_file_path:
            return

        try:
            # Eksik basliklar icin: incelenen RSP dosyasinin boyutu 16 bit ile uyumlu.
            # INT_FULL_SCALE=32768, SCALE.CHAN katsayisinin dogrudan carpan
            # oldugu varsayimidir; fiziksel degerleri kaynak yazilimla dogrulayin.
            # rpc-reader, dosyada zaten bulunan basliklari degistirmez.
            prc_object = rpc_reader.ReadRPC(
                rpc_file_path,
                extra_headers=[
                    ("DATA_TYPE", "SHORT_INTEGER"),
                    ("INT_FULL_SCALE", "32768"),
                ],
            )
            prc_object.import_rpc_data_from_file()
            channels = prc_object.get_channels()
            data = prc_object.get_data()
            time = prc_object.get_time()
        except SystemExit as exc:
            messagebox.showerror("RPC okuma hatasÄ±", str(exc))
            return
        except Exception as exc:
            messagebox.showerror("Dosya okuma hatasÄ±", str(exc))
            return

        self.head, self.tail = os.path.split(rpc_file_path)
        self.lb1.delete(0, tk.END)
        self.lb2.delete(0, tk.END)
        self.lab0['text'] = rpc_file_path
        self.data = data
        self.Z = time
        self.D=[]  # Create List
        self.U=[]  # Create List
        for key, value in channels.items():  # Get Channel Names from Description
            for subject, score in value.items():
                if subject == 'Description':
                    self.D.append(score)
                if subject == 'Units':  # Get Channel Units from Units
                    self.U.append(score)
            filename=self.D[key]
            self.lb1.insert(tk.END,filename)
            self.lb2.insert(tk.END,filename)
        self.lb1.insert(tk.END,'Time')
        self.lb2.insert(tk.END,'Time')

