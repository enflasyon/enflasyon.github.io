from tkinter import Tk, filedialog

root = Tk()
root.withdraw()
path = filedialog.askopenfilename(title="RSP dosyasını seç")
root.destroy()

if path:
    with open(path, "rb") as f:
        for i in range(20):
            record = f.read(128)
            if len(record) < 128:
                break

            key = record[:32].decode("cp1252", errors="replace")
            value = record[32:].decode("cp1252", errors="replace")

            print(
                i,
                repr(key.rstrip("\x00")),
                "=",
                repr(value.rstrip("\x00")),
            )