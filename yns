    def bt3_command(self):
        self.tree.delete(*self.tree.get_children())
        self.fig1, self.ax = plt.subplots()
        Column_Names=['Data Name','Data Min Value','Data Max Value','Units']
        self.Table_List = [["" for c in range(len(Column_Names))] for r in range(len(self.lb2select))]
        for item in self.canvas1.get_tk_widget().find_all():
            self.canvas1.get_tk_widget().delete(item)

        self.aydata=[]
        self.X_Data_Name = self.lb1select[0]
        if self.X_Data_Name=='Time':
            self.axdata = self.Z[0]
        else:
            AA=self.D.index(self.X_Data_Name)
            self.axdata=self.data[:,AA]

        for i in range(len(self.lb2select)):
            self.Y_Data_Name = self.lb2select[i]
            if self.Y_Data_Name=='Time':
                self.aydata.append(self.Z[0])
            else:
                AA=self.D.index(self.Y_Data_Name)
                self.aydata.append(self.data[:,AA])
            self.Table_List[i][0]=self.Y_Data_Name
            self.Table_List[i][1]=(min(self.aydata[i]))
            self.Table_List[i][2]=(max(self.aydata[i]))
            if self.Y_Data_Name=='Time':
                idxy='Sec'
                self.Table_List[i][3]=('['+idxy+']')
                self.ax.plot(self.axdata, self.aydata[i],label=self.Y_Data_Name+'['+idxy+']')
            else:
                idxy=self.D.index(self.Y_Data_Name)
                self.Table_List[i][3]=('['+self.U[idxy]+']')
                self.ax.plot(self.axdata, self.aydata[i],label=self.Y_Data_Name+'['+self.U[idxy]+']',linewidth=0.5)

            self.tree.insert('', 'end',iid=i, values=(self.Table_List[i][0],self.Table_List[i][1],self.Table_List[i][2],self.Table_List[i][3],))
        self.ax.axis('on')
        self.ax.legend(loc='upper left')
        self.ax.grid()
        self.canvas1 = FigureCanvasTkAgg(self.fig1, root)  # A tk.DrawingArea.
        self.canvas1.get_tk_widget().place(x=600,y=70,width=1200,height=600)
